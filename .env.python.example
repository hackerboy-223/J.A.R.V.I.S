# ========================================
# J.A.R.V.I.S. — Python Desktop Agent
# ========================================

# ---------- Brain / LLM ----------
JARVIS_LLM_PROVIDER="openrouter"

# OpenRouter
JARVIS_LLM_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY=""
# Backward-compatible alternative:
JARVIS_LLM_API_KEY=""
JARVIS_LLM_MODEL="openrouter/free"

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=""
OPENROUTER_X_TITLE="J.A.R.V.I.S."

# Local fallback if OpenRouter is unavailable/rate-limited
JARVIS_OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
JARVIS_OLLAMA_MODEL="qwen2.5:1.5b"

# ---------- Speech-to-text ----------
# hybrid = Vosk for live/wake-word + Groq Whisper for accurate final transcript.
JARVIS_STT_PROVIDER="hybrid"
GROQ_API_KEY=""
JARVIS_GROQ_STT_MODEL="whisper-large-v3-turbo"

# Local streaming / wake-word engine
JARVIS_VOSK_MODEL_PATH=""
JARVIS_LANGUAGE="fr"
JARVIS_AUDIO_DEVICE=""

# Emergency Whisper fallback only
JARVIS_WHISPER_MODEL="tiny"
JARVIS_WHISPER_COMPUTE="int8"
JARVIS_WHISPER_CPU_THREADS="2"
JARVIS_WHISPER_PARTIAL_TRANSCRIPTS="false"

# ---------- PC control ----------
JARVIS_ALLOW_PC_CONTROL="true"
JARVIS_CONFIRM_SAFE_PC_ACTIONS="false"

# ---------- Web search ----------
# Keep the real key only in your local .env file.
EXA_API_KEY=""
