# Brain provider: huggingface | openai_compatible
JARVIS_LLM_PROVIDER="huggingface"

# Hugging Face Inference Providers
HF_TOKEN=""
JARVIS_HF_MODEL="zai-org/GLM-5.3-Flash"
# auto = Hugging Face chooses an available provider
JARVIS_HF_PROVIDER="auto"

# Optional web search, following Open JARVIS
SERPER_API_KEY=""

# Optional OpenAI-compatible fallback/provider
JARVIS_LLM_BASE_URL="https://api.openai.com/v1"
JARVIS_LLM_API_KEY=""
JARVIS_LLM_MODEL="gpt-4o-mini"

# Explicit opt-in for local PC actions.
JARVIS_ALLOW_PC_CONTROL="false"

# Offline speech-to-text
JARVIS_WHISPER_MODEL="base"
JARVIS_WHISPER_COMPUTE="int8"
JARVIS_LANGUAGE="fr"

# Optional microphone selection: device index or part of its Windows device name.
# Leave empty to use the Windows default input.
JARVIS_AUDIO_DEVICE=""
