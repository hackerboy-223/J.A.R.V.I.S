# Brain provider: huggingface | openai_compatible
JARVIS_LLM_PROVIDER="huggingface"

# Hugging Face Inference Providers
HF_TOKEN=""
JARVIS_HF_MODEL="zai-org/GLM-5.3-Flash"
JARVIS_HF_PROVIDER="auto"

# Local Ollama fallback when Hugging Face is unavailable / out of credits.
JARVIS_OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
JARVIS_OLLAMA_MODEL="qwen2.5:1.5b"

# Optional web search
SERPER_API_KEY=""

# Optional OpenAI-compatible provider
JARVIS_LLM_BASE_URL="https://api.openai.com/v1"
JARVIS_LLM_API_KEY=""
JARVIS_LLM_MODEL="gpt-4o-mini"

JARVIS_ALLOW_PC_CONTROL="false"

# Speech-to-text
# vosk = low-memory local streaming French speech recognition.
JARVIS_STT_PROVIDER="vosk"
JARVIS_VOSK_MODEL_PATH=""

# Optional remote/fallback STT
JARVIS_HF_ASR_MODEL=""

# Emergency Whisper fallback only
JARVIS_WHISPER_MODEL="tiny"
JARVIS_WHISPER_COMPUTE="int8"
JARVIS_WHISPER_CPU_THREADS="2"
JARVIS_WHISPER_PARTIAL_TRANSCRIPTS="false"

JARVIS_LANGUAGE="fr"
JARVIS_AUDIO_DEVICE=""
