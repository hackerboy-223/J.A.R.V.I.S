# Base de données SQLite (Prisma)
DATABASE_URL="file:../db/custom.db"

# Sécurité — obligatoire en production
# Mot de passe utilisé pour ouvrir l'interface J.A.R.V.I.S.
JARVIS_ACCESS_PASSWORD="change-me"

# Secret long et aléatoire (24 caractères minimum) pour signer les cookies HttpOnly.
JARVIS_SESSION_SECRET="change-me-with-a-long-random-secret"

# Clé utilisée pour chiffrer les secrets persistés (ex. token Hugging Face).
JARVIS_ENCRYPTION_KEY="change-me-with-another-long-random-secret"

# Désactivé par défaut en production. Ne l'activer que dans un environnement isolé.
JARVIS_ALLOW_RUN_JS="false"
