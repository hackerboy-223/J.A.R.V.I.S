# Base de données SQLite (Prisma)
DATABASE_URL="file:../db/custom.db"

# Sécurité — obligatoire en production.
# Laisser vide dans l'exemple évite de déployer accidentellement des secrets faibles.
# Mot de passe : 12 caractères minimum.
JARVIS_ACCESS_PASSWORD=""

# Secret aléatoire : 32 caractères minimum.
JARVIS_SESSION_SECRET=""

# Clé dédiée au chiffrement des secrets persistés (ex. token Hugging Face).
JARVIS_ENCRYPTION_KEY=""

# Désactivé par défaut en production. Ne l'activer que dans un environnement isolé.
JARVIS_ALLOW_RUN_JS="false"
